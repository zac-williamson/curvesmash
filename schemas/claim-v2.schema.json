{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curvesma.sh exploratory claim v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_profile",
    "target_id",
    "cost_model",
    "target_profile_sha256",
    "cost_model_sha256",
    "submission_state",
    "review_status",
    "baseline_kind",
    "algorithm",
    "proof",
    "claim",
    "heuristics",
    "limitations",
    "lane"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "target_profile": {
      "const": "production-v2"
    },
    "target_id": {
      "enum": [
        "secp256k1-ecdlp",
        "bls12-381-invert-g1"
      ]
    },
    "cost_model": {
      "const": "classical-group-work-v2"
    },
    "target_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cost_model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "submission_state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "review_status": {
      "const": "pending"
    },
    "baseline_kind": {
      "enum": [
        "generic-accounting-control",
        "research-claim"
      ]
    },
    "algorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "proof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_log2",
        "time_unit",
        "memory_log2_bytes",
        "preprocessing_log2",
        "success_probability",
        "nonuniform_advice_log2_bytes"
      ],
      "properties": {
        "time_log2": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        },
        "time_unit": {
          "const": "target-group-operations"
        },
        "memory_log2_bytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        },
        "preprocessing_log2": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        },
        "success_probability": {
          "type": "number",
          "minimum": 0.39,
          "maximum": 1
        },
        "nonuniform_advice_log2_bytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        }
      }
    },
    "heuristics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "role",
          "evidence",
          "scope",
          "extrapolation",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "extrapolation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "lane": {
      "const": "exploratory"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "trials"
      ],
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "kind": {
          "enum": [
            "attack",
            "analysis"
          ]
        }
      }
    }
  }
}
